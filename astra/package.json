{
  "name": "moss-and-moon",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm install --no-audit --no-fund && vite --host 127.0.0.1",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/bundle-size.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node scripts/verify.mjs smoke",
    "bench": "node scripts/verify.mjs bench",
    "test:long": "node scripts/verify.mjs long",
    "test:features": "node scripts/verify.mjs features",
    "screenshots": "node scripts/verify.mjs screenshots"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "playwright": "^1.56.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
